# Supabase credentials (NEW API KEYS FORMAT - as of 2026)
# Get these from your Supabase project: Settings → API Keys → "Publishable and secret API keys"
# 
# For backend/server (this FastAPI app):
#   Use: Secret key (sb_secret_xxx)
# For frontend/client code:
#   Use: Publishable key (sb_publishable_xxx)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_...  # Use secret key for backend

# Application settings
SECRET_KEY=your-secret-key-change-in-production
BASE_URL=http://127.0.0.1:8000

# Optional: For production only
# DB_PATH=codeclub.db  # (no longer used with Supabase)
